---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { kebabCase } from "../../utils/slugify"

const posts = await getCollection("posts")
const counts = new Map()
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1)
  }
}
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]))
---

<Layout
  title="Tags | Penny Xu"
  description="Browse Penny Xu's technical writing by topic — CUDA, GPUs, LLM inference, deep learning, and computer vision."
>
  <h1>Tags</h1>
  <ul class="tag-list">
    {
      tags.map(([tag, count]) => (
        <li>
          <a class="tag" href={`/tags/${kebabCase(tag)}/`}>
            {tag} <span class="count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style lang="scss">
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 150ms ease;

    &:hover {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .count {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
</style>
