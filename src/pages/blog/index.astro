---
import { getCollection } from "astro:content"
import Layout from "../../layouts/Layout.astro"

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
---

<Layout
  title="Blog | Penny Xu"
  description="Essays and visual explainers on LLM inference, CUDA, GPU programming, and deep learning fundamentals — by Penny Xu."
>
  <h1>Blog</h1>
  <ol class="posts">
    {
      posts.map((post) => (
        <li class="post">
          <a href={`/blog/${post.id}/`}>
            <h2>{post.data.title}</h2>
            <p class="date">{post.data.date.toISOString().slice(0, 10)}</p>
            <ul class="tags">
              {post.data.tags.slice(0, 4).map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </a>
        </li>
      ))
    }
  </ol>
  <a class="tags-link" href="/tags">All Tags →</a>
</Layout>

<style lang="scss">
  .posts {
    list-style-type: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .post {
    a {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text);
      display: block;
      padding: 1.15rem 1.35rem;
      border-radius: 10px;
      text-decoration: none;
      transition: border-color 150ms ease, transform 150ms ease;

      &:hover {
        opacity: 1;
        border-color: var(--color-accent);
        transform: translateX(2px);

        h2 {
          color: var(--color-accent-strong);
        }
      }
    }

    h2 {
      margin-bottom: 0.3rem;
      font-size: 1.3rem;
      transition: color 150ms ease;
    }
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin-bottom: 0.6rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  .tags-link {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;

    &:hover {
      color: var(--color-accent-strong);
    }
  }
</style>
