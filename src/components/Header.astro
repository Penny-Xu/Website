---
const path = Astro.url.pathname
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href)

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About Me" },
]
---

<header class="header">
  <h1>
    <a class="title" href="/">Penny Xu</a>
  </h1>
  <nav>
    <ul class="nav-list">
      {
        links.map((link) => (
          <li>
            <a
              class="nav-item"
              class:list={{ active: isActive(link.href) }}
              href={link.href}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style lang="scss">
  .header {
    padding: 1rem 0 3rem;
  }

  .title {
    display: inline-block;
    color: var(--color-text);
    font-size: 2.75rem;
    text-decoration: none;
    transition: color 150ms ease;

    &:hover {
      color: var(--color-accent-strong);
      opacity: 1;
    }
  }

  .nav-list {
    display: flex;
    list-style-type: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    margin-right: 1.5rem;
    padding-bottom: 0.3rem;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      left: 0;
      right: 100%;
      bottom: 0;
      height: 2px;
      background: var(--color-accent);
      transition: right 200ms ease;
    }

    &:hover {
      color: var(--color-text);
      opacity: 1;

      &::after {
        right: 0;
      }
    }

    &.active {
      color: var(--color-text);

      &::after {
        right: 0;
      }
    }
  }
</style>
