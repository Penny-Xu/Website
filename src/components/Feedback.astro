---
const email = "yuexu97@gmail.com"
---

<section class="feedback">
  <p>
    Found this useful, or found a mistake? I'd genuinely like to hear about it —
    <a href={`mailto:${email}?subject=${encodeURIComponent("Re: your blog")}`}>
      email me
    </a>.
  </p>
</section>

<style lang="scss">
  .feedback {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);

    p {
      color: var(--color-text-muted);
      font-size: 0.9rem;
      margin: 0;
    }

    a {
      color: var(--color-accent-strong);
      font-weight: 500;
    }
  }
</style>
